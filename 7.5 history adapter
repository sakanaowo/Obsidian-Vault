app/src/main/java/com/example/calculator/ui/adapter/HistoryAdapter.java

Thay toàn bộ nội dung bằng:

package com.example.calculator.ui.adapter;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.TextView;
import androidx.annotation.NonNull;
import androidx.recyclerview.widget.RecyclerView;
import com.example.calculator.R;
import com.example.calculator.model.HistoryItem;
import java.util.ArrayList;
import java.util.List;
/**
 * Adapter hiển thị Calculation History.
 *
 * Input:
 *
 * List<HistoryItem>
 *
 * Output:
 *
 * item_history.xml
 *
 * Adapter chỉ chịu trách nhiệm:
 *
 * - Inflate layout
 * - Bind expression
 * - Bind result
 * - Forward long-click event
 *
 * Adapter không trực tiếp thao tác SharedPreferences.
 */
public class HistoryAdapter
        extends RecyclerView.Adapter<HistoryAdapter.HistoryViewHolder> {
    // Danh sách đang được hiển thị.
    private final List<HistoryItem> items =
            new ArrayList<>();
    // Callback dùng cho thao tác xóa item sau này.
    private final OnHistoryItemLongClickListener longClickListener;
    /**
     * Callback long press.
     *
     * HistoryBottomSheet sẽ implement callback này
     * ở bước Delete sau.
     */
    public interface OnHistoryItemLongClickListener {
        void onHistoryItemLongClick(
                HistoryItem item
        );
    }
    // =========================================================
    // CONSTRUCTOR
    // =========================================================
    public HistoryAdapter(
            List<HistoryItem> initialItems,
            OnHistoryItemLongClickListener longClickListener
    ) {
        this.longClickListener =
                longClickListener;
        if (initialItems != null) {
            items.addAll(
                    initialItems
            );
        }
    }
    // =========================================================
    // CREATE VIEW HOLDER
    // =========================================================
    @NonNull
    @Override
    public HistoryViewHolder onCreateViewHolder(
            @NonNull ViewGroup parent,
            int viewType
    ) {
        View itemView =
                LayoutInflater
                        .from(parent.getContext())
                        .inflate(
                                R.layout.item_history,
                                parent,
                                false
                        );
        return new HistoryViewHolder(
                itemView
        );
    }
    // =========================================================
    // BIND
    // =========================================================
    @Override
    public void onBindViewHolder(
            @NonNull HistoryViewHolder holder,
            int position
    ) {
        HistoryItem item =
                items.get(position);
        holder.bind(
                item,
                longClickListener
        );
    }
    // =========================================================
    // COUNT
    // =========================================================
    @Override
    public int getItemCount() {
        return items.size();
    }
    // =========================================================
    // UPDATE DATA
    // =========================================================
    /**
     * Thay toàn bộ dữ liệu hiện tại.
     *
     * Sau này dùng khi:
     *
     * - mở History
     * - delete item
     * - clear all
     */
    public void submitList(
            List<HistoryItem> newItems
    ) {
        items.clear();
        if (newItems != null) {
            items.addAll(
                    newItems
            );
        }
        notifyDataSetChanged();
    }
    // =========================================================
    // VIEW HOLDER
    // =========================================================
    static class HistoryViewHolder
            extends RecyclerView.ViewHolder {
        private final TextView tvExpression;
        private final TextView tvResult;
        public HistoryViewHolder(
                @NonNull View itemView
        ) {
            super(itemView);
            tvExpression =
                    itemView.findViewById(
                            R.id.tvHistoryExpression
                    );
            tvResult =
                    itemView.findViewById(
                            R.id.tvHistoryResult
                    );
        }
        /**
         * Bind một HistoryItem vào row.
         */
        public void bind(
                HistoryItem item,
                OnHistoryItemLongClickListener longClickListener
        ) {
            tvExpression.setText(
                    item.getExpression()
            );
            tvResult.setText(
                    item.getResult()
            );
            /*
             * Chuẩn bị interaction xóa item.
             *
             * Chưa trực tiếp delete tại Adapter.
             *
             * Adapter chỉ báo ngược event cho
             * HistoryBottomSheet.
             */
            if (longClickListener != null) {
                itemView.setOnLongClickListener(view -> {
                    longClickListener
                            .onHistoryItemLongClick(
                                    item
                            );
                    return true;
                });
            } else {
                itemView.setOnLongClickListener(
                        null
                );
            }
        }
    }
}

